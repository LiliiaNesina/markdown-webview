<body>
    <div id="markdown-rendered"></div>
    <script>
        const markdownIt = window.markdownit({
            highlight: function (str, lang) {
                if (lang && hljs.getLanguage(lang)) {
                    try {
                        return hljs.highlight(str, {language: lang}).value;
                    } catch (__) { }
                } else {
                    try {
                        return hljs.highlightAuto(str).value;
                    } catch (__) { }
                }

                return ``;
            },
            linkify: true,
            html: true
        })
            .use(window.markdownitMark)
            .use(window.markdownitTaskLists)
            .use(window.texmath, {
                engine: window.katex,
                delimiters: ['dollars', 'brackets', 'doxygen', 'gitlab', 'julia', 'kramdown', 'beg_end'],
                katexOptions: {
                    throwOnError: false,
                    errorColor: '#cc0000',
                },
            });

        const markdownRenderedElement = document.getElementById(`markdown-rendered`);
        // Offscreen staging element for diffing (outside body to avoid affecting height)
        const _stagingEl = document.createElement('div');
        _stagingEl.style.cssText = 'position:absolute;left:-9999px;top:-9999px;visibility:hidden;';
        document.documentElement.appendChild(_stagingEl);

        // Incremental DOM patch — only update/add/remove changed top-level children
        // Staging has raw markdown-it output (<pre>, <p>, etc.)
        // Live DOM may have wrappers: pre → div.code-block-wrapper → div.artifact-container
        function patchChildren(target, source) {
            const targetKids = Array.from(target.childNodes);
            const sourceKids = Array.from(source.childNodes);
            const len = Math.max(targetKids.length, sourceKids.length);
            for (let i = 0; i < len; i++) {
                const tChild = targetKids[i];
                const sChild = sourceKids[i];
                if (!sChild) {
                    tChild.remove();
                } else if (!tChild) {
                    target.appendChild(sChild.cloneNode(true));
                } else {
                    // Preserve artifact containers — live iframe must not be destroyed
                    if (tChild.classList && tChild.classList.contains('artifact-container')) continue;
                    // Preserve code-block wrappers — only update inner <pre> content
                    if (tChild.classList && tChild.classList.contains('code-block-wrapper')) {
                        const tPre = tChild.querySelector('pre');
                        const sPre = sChild.nodeName === 'PRE' ? sChild : (sChild.querySelector && sChild.querySelector('pre'));
                        if (tPre && sPre && tPre.innerHTML !== sPre.innerHTML) {
                            tPre.innerHTML = sPre.innerHTML;
                        }
                        continue;
                    }
                    // Different node type/name — replace
                    if (tChild.nodeType !== sChild.nodeType || tChild.nodeName !== sChild.nodeName) {
                        target.replaceChild(sChild.cloneNode(true), tChild);
                    } else if (tChild.nodeType === 3) {
                        if (tChild.textContent !== sChild.textContent) {
                            tChild.textContent = sChild.textContent;
                        }
                    } else if (tChild.outerHTML !== sChild.outerHTML) {
                        target.replaceChild(sChild.cloneNode(true), tChild);
                    }
                }
            }
        }

        // --- Streaming fade -------------------------------------------------
        // While a reply streams, the native side pushes the growing text a few
        // times per frame budget. Every render patches whole blocks in, so the
        // characters that just arrived would pop into place. Instead the text
        // rendered since the previous frame is wrapped in spans that fade in.
        // The wrappers are rebuilt from scratch on every frame, and a span
        // recreated for text that was already fading resumes at the same
        // point (negative animation-delay), so the fade stays continuous
        // while the DOM underneath is replaced.
        const STREAM_FADE_MS = 320;
        let _streamFadeEnabled = false;
        let _streamText = '';
        let _streamSegments = [];

        window.setStreamingFade = (enabled) => {
            _streamFadeEnabled = !!enabled;
            _streamSegments = [];
            _streamText = _streamFadeEnabled ? _streamTextNodes().map((n) => n.data).join('') : '';
        };

        function _streamTextNodes() {
            const nodes = [];
            const walker = document.createTreeWalker(markdownRenderedElement, NodeFilter.SHOW_TEXT, {
                acceptNode(node) {
                    for (let el = node.parentElement; el && el !== markdownRenderedElement; el = el.parentElement) {
                        if (el.tagName === 'BUTTON'
                            || el.classList.contains('katex')
                            || el.classList.contains('artifact-container')
                            || el.classList.contains('artifact-streaming-placeholder')) {
                            return NodeFilter.FILTER_REJECT;
                        }
                    }
                    return NodeFilter.FILTER_ACCEPT;
                }
            });
            let node;
            while ((node = walker.nextNode())) nodes.push(node);
            return nodes;
        }

        function _unwrapStreamSpans() {
            const spans = markdownRenderedElement.querySelectorAll('span.cc-stream-in');
            if (spans.length === 0) return;
            spans.forEach((span) => span.replaceWith(document.createTextNode(span.textContent)));
            markdownRenderedElement.normalize();
        }

        function _applyStreamFade() {
            const now = performance.now();
            _unwrapStreamSpans();
            const nodes = _streamTextNodes();
            const text = nodes.map((n) => n.data).join('');
            const limit = Math.min(text.length, _streamText.length);
            let prefix = 0;
            while (prefix < limit && text.charCodeAt(prefix) === _streamText.charCodeAt(prefix)) prefix++;
            _streamSegments = _streamSegments
                .filter((s) => now - s.at < STREAM_FADE_MS && s.from < prefix)
                .map((s) => ({ from: s.from, to: Math.min(s.to, prefix), at: s.at }));
            if (text.length > prefix) _streamSegments.push({ from: prefix, to: text.length, at: now });
            _streamText = text;
            if (_streamSegments.length === 0) return;

            let offset = 0;
            for (const node of nodes) {
                const start = offset;
                const end = offset + node.data.length;
                offset = end;
                const pieces = [];
                for (const seg of _streamSegments) {
                    const a = Math.max(seg.from, start) - start;
                    const b = Math.min(seg.to, end) - start;
                    if (a < b) pieces.push({ a, b, at: seg.at });
                }
                if (pieces.length === 0) continue;
                const data = node.data;
                const fragment = document.createDocumentFragment();
                let cursor = 0;
                for (const piece of pieces) {
                    if (piece.a > cursor) fragment.appendChild(document.createTextNode(data.slice(cursor, piece.a)));
                    const span = document.createElement('span');
                    span.className = 'cc-stream-in';
                    span.style.animationDelay = `${-(now - piece.at)}ms`;
                    span.textContent = data.slice(piece.a, piece.b);
                    fragment.appendChild(span);
                    cursor = piece.b;
                }
                if (cursor < data.length) fragment.appendChild(document.createTextNode(data.slice(cursor)));
                node.parentNode.replaceChild(fragment, node);
            }
        }

        window.updateWithMarkdownContentBase64Encoded = (markdownContentBase64Encoded, withButton, imageUrlsArray) => {
            let markdownContent = decodeURIComponent(atob(markdownContentBase64Encoded).split(``).map(function (c) {return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);}).join(``));

            // Hide incomplete HTML code blocks during streaming
            markdownContent = preprocessStreamingArtifacts(markdownContent);

            if (withButton) {
                let urls = Array.isArray(imageUrlsArray) ? imageUrlsArray.slice(0, 3) : [];
                let imagesHTML = '';

                if (urls.length > 0) {
                    urls.forEach((url, idx) => {
                        let marginLeft = idx === 0 ? '' : 'margin-left: -5px;';
                        let zIndex = 3 - idx;
                        imagesHTML += `<img src="${url}"
                            style="width: 13px; height: 13px; object-fit: cover; border-radius: 50%; border: 0.5px solid #dddddd; ${marginLeft} z-index: ${zIndex};" />`;
                    });
                    imagesHTML = `<div style="display: flex; align-items: center; margin-right: 0;">${imagesHTML}</div>`;
                }

                const inlineButtonHTML = `
                <button style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 4px;
                    padding: 4px 8px;
                    line-height: 1.5;
                    color: PLACEHOLDER_LINK_COLOR;
                    border: none;
                    border-radius: 9999px;
                    cursor: pointer;
                    vertical-align: middle;
                    " onclick="window.webkit.messageHandlers.sourcesTapped.postMessage('')">
                    ${imagesHTML || ''} PLACEHOLDER_BUTTON_TEXT <span style="font-size: 12px; display: inline-block; transform: scaleX(0.5);">></span>
                </button>
                `;
                _stagingEl.innerHTML = markdownIt.render(markdownContent);
                const lastChild = _stagingEl.lastElementChild;
                const isBlock = lastChild && ['TABLE', 'PRE', 'UL', 'OL', 'BLOCKQUOTE', 'HR'].includes(lastChild.tagName);

                if (isBlock) {
                    if (lastChild && lastChild.tagName === 'HR') {
                        lastChild.insertAdjacentHTML('beforebegin', inlineButtonHTML);
                    } else {
                        _stagingEl.insertAdjacentHTML('beforeend', inlineButtonHTML);
                    }
                } else {
                    _stagingEl.innerHTML = markdownIt.render(markdownContent + inlineButtonHTML);
                }
            } else {
                _stagingEl.innerHTML = markdownIt.render(markdownContent);
            }

            // Patch only changed nodes instead of full innerHTML swap
            patchChildren(markdownRenderedElement, _stagingEl);

            addCopyButtons()
            processArtifacts()
            if (_streamFadeEnabled) _applyStreamFade();
            window.webkit.messageHandlers.renderedContentHandler.postMessage(markdownContentBase64Encoded);
        }

        // --- Streaming: hide incomplete HTML code blocks ---
        function preprocessStreamingArtifacts(md) {
            // Check if there's an unclosed ```html block (streaming in progress)
            // Match ```html with optional whitespace/newline OR at end of string
            const htmlOpens = [...md.matchAll(/```html\s*(?:\n|$)/gi)];
            if (htmlOpens.length === 0) {
                // Also catch ```html without trailing newline mid-stream (e.g. "```html" at very end)
                if (/```html\s*$/i.test(md)) {
                    const idx = md.search(/```html\s*$/i);
                    const beforeBlock = md.substring(0, idx);
                    return beforeBlock + '\n<div class="artifact-streaming-placeholder"><div class="artifact-streaming-spinner"></div>Generating interactive content...</div>\n';
                }
                return md;
            }

            const lastOpen = htmlOpens[htmlOpens.length - 1];
            const afterOpen = md.substring(lastOpen.index + lastOpen[0].length);

            // Check if there's a closing ``` after the last ```html
            if (!/```/.test(afterOpen)) {
                // Incomplete block — replace with placeholder
                const beforeBlock = md.substring(0, lastOpen.index);
                return beforeBlock + '\n<div class="artifact-streaming-placeholder"><div class="artifact-streaming-spinner"></div>Generating interactive content...</div>\n';
            }

            return md;
        }

        // --- Interactive Artifact Support ---
        function isInteractiveHTML(code) {
            return /<script[\s>]/i.test(code) ||
                   /oninput\s*=/i.test(code) ||
                   /onclick\s*=/i.test(code) ||
                   /onchange\s*=/i.test(code) ||
                   /<canvas[\s>]/i.test(code) ||
                   /<svg[\s>]/i.test(code) ||
                   /<input[\s>]/i.test(code) ||
                   /<select[\s>]/i.test(code) ||
                   /<button[\s>]/i.test(code);
        }

        function extractArtifactTitle(code) {
            const titleMatch = code.match(/<title>(.*?)<\/title>/i);
            if (titleMatch) return titleMatch[1];
            const h1Match = code.match(/<h1[^>]*>(.*?)<\/h1>/i);
            if (h1Match) return h1Match[1].replace(/<[^>]+>/g, '');
            return 'Interactive';
        }

        function sanitizeArtifactHTML(code) {
            // Strip any attempts to access webkit messageHandlers
            return code.replace(/window\.webkit\.messageHandlers/g, '/* blocked */void 0')
                       .replace(/parent\./g, '/* blocked */void 0.');
        }

        function createArtifactIframe(htmlContent) {
            const iframe = document.createElement('iframe');
            iframe.className = 'artifact-iframe';
            iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
            iframe.setAttribute('allowtransparency', 'true');
            const safeHTML = sanitizeArtifactHTML(htmlContent);

            // Default styles for iframe content — compact for mobile
            const defaultStyles = `<style>
                * { box-sizing: border-box; }
                html, body {
                    margin: 0; padding: 0;
                    font-family: system-ui, -apple-system, sans-serif;
                    font-size: 14px; line-height: 1.4;
                    font-variant-numeric: tabular-nums;
                    -webkit-text-size-adjust: 100%;
                    background: transparent;
                    overflow-x: hidden;
                }
                h1 { font-size: 18px; margin: 0 0 8px; }
                h2 { font-size: 16px; margin: 0 0 6px; }
                h3 { font-size: 15px; margin: 0 0 4px; }
                p { margin: 4px 0; font-size: 14px; }
                label, span, div { font-size: 14px; }
                small, sub, sup, figcaption, caption { font-size: 13px; }
                svg text, svg tspan { font-size: 13px !important; }
                input[type="range"] { width: 100%; }
                canvas { max-width: 100%; height: auto; }
                .katex { font-size: 1em !important; }
            </style>`;

            // Canvas min-font patch — MUST be in <head> before any scripts run
            // Note: <\/script> is split to avoid HTML parser closing the outer script tag
            const canvasPatch = `<${'script'}>
                (function() {
                    var minFS = 13;
                    var origFont = Object.getOwnPropertyDescriptor(CanvasRenderingContext2D.prototype, "font");
                    if (origFont && origFont.set) {
                        Object.defineProperty(CanvasRenderingContext2D.prototype, "font", {
                            set: function(v) {
                                var m = v.match(/(\\d+(?:\\.\\d+)?)(px|pt|em|rem)/i);
                                if (m) {
                                    var s = parseFloat(m[1]);
                                    var u = m[2];
                                    if (u === "px" && s < minFS) v = v.replace(m[0], minFS + "px");
                                    else if (u === "pt" && s < minFS * 0.75) v = v.replace(m[0], (minFS * 0.75) + "pt");
                                }
                                origFont.set.call(this, v);
                            },
                            get: function() { return origFont.get.call(this); },
                            configurable: true
                        });
                    }
                })();
            </${'script'}>`;

            // Wrap in full HTML if it's a fragment
            let fullHTML = safeHTML;
            if (!/<html[\s>]/i.test(safeHTML)) {
                fullHTML = '<!DOCTYPE html><html><head>' +
                    '<meta charset="UTF-8">' +
                    '<meta name="viewport" content="width=device-width, initial-scale=1.0">' +
                    defaultStyles + canvasPatch +
                    '</head><body>' + safeHTML + '</body></html>';
            } else {
                fullHTML = fullHTML.replace('</he' + 'ad>', defaultStyles + canvasPatch + '</he' + 'ad>');
            }

            // Inject theme + KaTeX math rendering + resize reporter
            const resizeScript = `<${'script'}>
                (function() {
                    // --- KaTeX formula rendering via parent ---
                    try {
                        var pk = parent.katex;
                        if (pk) {
                            // Copy KaTeX CSS from parent into iframe
                            var styles = parent.document.querySelectorAll("style");
                            styles.forEach(function(s) {
                                if (s.textContent.indexOf(".katex") !== -1) {
                                    var c = document.createElement("style");
                                    c.textContent = s.textContent;
                                    document.head.appendChild(c);
                                }
                            });

                            // Walk text nodes and render $...$ formulas
                            function walkMath(node) {
                                if (node.nodeType === 3) {
                                    var t = node.textContent;
                                    if (t.indexOf("$") === -1) return;
                                    var span = document.createElement("span");
                                    span.innerHTML = t
                                        .replace(/\\$\\$([\\s\\S]+?)\\$\\$/g, function(m, f) {
                                            try { return pk.renderToString(f, { displayMode: true, throwOnError: false }); }
                                            catch(e) { return m; }
                                        })
                                        .replace(/\\$([^\\$\\s][^\\$]*?[^\\$\\s])\\$/g, function(m, f) {
                                            try { return pk.renderToString(f, { throwOnError: false }); }
                                            catch(e) { return m; }
                                        })
                                        .replace(/\\$([^\\$\\s])\\$/g, function(m, f) {
                                            try { return pk.renderToString(f, { throwOnError: false }); }
                                            catch(e) { return m; }
                                        });
                                    if (span.innerHTML !== t) node.parentNode.replaceChild(span, node);
                                } else if (node.nodeType === 1 && !/^(SCRIPT|STYLE|PRE|CODE|TEXTAREA)$/.test(node.tagName)) {
                                    Array.from(node.childNodes).forEach(walkMath);
                                }
                            }
                            walkMath(document.body);
                        }
                    } catch(e) {}

                    // --- Theme: exact same logic as ArtifactWebViewController.applyThemeIfNeeded() ---
                    function applyThemeIfNeeded(isDark) {
                        var tags = ['h1','h2','h3','h4','h5','h6'];
                        for (var i = 0; i < tags.length; i++) {
                            var el = document.querySelector(tags[i]);
                            if (!el) continue;
                            var c = getComputedStyle(el).color;
                            var m = c.match(/(\\d+),\\s*(\\d+),\\s*(\\d+)/);
                            if (!m) continue;
                            var lum = (parseInt(m[1])*299+parseInt(m[2])*587+parseInt(m[3])*114)/1000;
                            var contentDark = lum > 128;
                            var shouldInvert = (isDark && !contentDark) || (!isDark && contentDark);
                            if (shouldInvert) {
                                document.documentElement.style.setProperty('filter','invert(1) hue-rotate(180deg)','important');
                                document.querySelectorAll('img,video').forEach(function(el){
                                    el.style.setProperty('filter','invert(1) hue-rotate(180deg)','important');
                                });
                            } else {
                                document.documentElement.style.removeProperty('filter');
                                document.querySelectorAll('img,video').forEach(function(el){
                                    el.style.removeProperty('filter');
                                });
                            }
                            return;
                        }
                    }

                    function checkTheme() {
                        try {
                            var isDark = parent.document.body.classList.contains('dark-theme');
                            applyThemeIfNeeded(isDark);
                        } catch(e) {}
                    }

                    checkTheme();
                    setTimeout(checkTheme, 150);
                    setTimeout(checkTheme, 500);
                    setTimeout(checkTheme, 1500);

                    window.addEventListener('message', function(event) {
                        if (event.data && event.data.type === 'artifact-theme-update') {
                            applyThemeIfNeeded(event.data.isDark);
                        }
                    });

                    // --- Resize reporter ---
                    var lastReportedH = 0;
                    var resizeDebounceTimer = 0;
                    var MAX_ARTIFACT_H = Math.round(window.innerHeight * 0.7) || 600;
                    function reportHeight() {
                        var body = document.body;
                        var h = Math.ceil(body.scrollHeight);
                        h = Math.min(h, MAX_ARTIFACT_H);
                        if (h > 0 && Math.abs(h - lastReportedH) > 3) {
                            lastReportedH = h;
                            window.parent.postMessage({ type: "artifact-resize", height: h }, "*");
                        }
                    }
                    function debouncedReport() {
                        clearTimeout(resizeDebounceTimer);
                        resizeDebounceTimer = setTimeout(reportHeight, 100);
                    }
                    new ResizeObserver(debouncedReport).observe(document.body);
                    new MutationObserver(debouncedReport)
                        .observe(document.body, { childList: true, subtree: true, attributes: true });
                    reportHeight();
                    setTimeout(reportHeight, 100);
                    setTimeout(reportHeight, 500);
                    setTimeout(reportHeight, 1500);
                    setTimeout(reportHeight, 3000);
                })();
            </${'script'}>`;

            fullHTML = fullHTML.replace('</bo' + 'dy>', resizeScript + '</bo' + 'dy>');

            iframe.srcdoc = fullHTML;
            return iframe;
        }

        function processArtifacts() {
            // Find all code blocks with language "html"
            const codeBlocks = markdownRenderedElement.querySelectorAll('pre code.language-html, pre code.hljs.language-html');

            codeBlocks.forEach((codeEl) => {
                const code = codeEl.textContent;
                if (!isInteractiveHTML(code)) return;

                const preEl = codeEl.closest('pre');
                // Check if already wrapped by copy-button wrapper
                const wrapper = preEl.parentElement.classList.contains('code-block-wrapper')
                    ? preEl.parentElement
                    : preEl;

                // Skip if already processed into an artifact container
                if (wrapper.parentElement && wrapper.parentElement.classList.contains('artifact-container')) return;

                const title = extractArtifactTitle(code);

                const container = document.createElement('div');
                container.className = 'artifact-container';

                // Header (hidden by default, shown in code view)
                const header = document.createElement('div');
                header.className = 'artifact-header';

                const toggleBtn = document.createElement('button');
                toggleBtn.className = 'artifact-toggle-btn';
                toggleBtn.textContent = 'Preview';
                toggleBtn.addEventListener('click', () => {
                    container.classList.toggle('show-code');
                    toggleBtn.textContent = container.classList.contains('show-code') ? 'Preview' : 'Code';
                });

                header.appendChild(toggleBtn);

                // Iframe
                const iframe = createArtifactIframe(code);

                // Code fallback (the original pre block)
                const codeFallback = document.createElement('div');
                codeFallback.className = 'artifact-code-fallback';
                codeFallback.appendChild(wrapper.cloneNode(true));

                // "Try it" overlay button centered over iframe
                const overlay = document.createElement('div');
                overlay.className = 'artifact-overlay';
                const openBtn = document.createElement('button');
                openBtn.className = 'artifact-open-btn';
                openBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg> PLACEHOLDER_TRY_IT_TEXT';
                openBtn.addEventListener('click', () => {
                    const base64 = btoa(unescape(encodeURIComponent(code)));
                    window.webkit.messageHandlers.openArtifact.postMessage(base64);
                });
                overlay.appendChild(openBtn);

                container.appendChild(header);
                container.appendChild(iframe);
                container.appendChild(overlay);
                container.appendChild(codeFallback);

                wrapper.replaceWith(container);
            });
        }

        // Theme: toggle CSS class on body + notify all artifact iframes
        window.updateArtifactTheme = function(isDark) {
            document.body.classList.toggle('dark-theme', isDark);
            // Broadcast theme change to all artifact iframes
            document.querySelectorAll('.artifact-iframe').forEach(function(iframe) {
                try {
                    iframe.contentWindow.postMessage({ type: 'artifact-theme-update', isDark: isDark }, '*');
                } catch(e) {}
            });
        };

        // Listen for iframe resize messages
        const MAX_IFRAME_HEIGHT = Math.round(window.innerHeight * 0.7) || 600;
        window.addEventListener('message', (event) => {
            if (!event.data || !event.data.type) return;
            const iframes = document.querySelectorAll('.artifact-iframe');
            if (event.data.type === 'artifact-resize') {
                iframes.forEach((iframe) => {
                    if (iframe.contentWindow === event.source) {
                        let h = Math.min(event.data.height, MAX_IFRAME_HEIGHT);
                        const newH = h + 'px';
                        if (iframe.style.height !== newH) {
                            iframe.style.height = newH;
                            if (!_resizePending) {
                                _resizePending = true;
                                requestAnimationFrame(_flushResize);
                            }
                        }
                    }
                });
            }
        });

        function addCopyButtons() {
            const codeBlocks = document.querySelectorAll('pre');
            codeBlocks.forEach((codeBlock) => {
                // Skip if already wrapped
                if (codeBlock.parentElement && codeBlock.parentElement.classList.contains('code-block-wrapper')) return;
                const button = document.createElement('button');
                button.className = 'copy-code-button';
                button.innerHTML = '<i class="fa-regular fa-clone"></i>';
                button.addEventListener('click', async () => {
                    window.webkit.messageHandlers.copyToPasteboard.postMessage(codeBlock.innerText);
                    button.innerHTML = '<i class="fa-solid fa-check"></i>';
                    button.classList.add('copied');
                    setTimeout(() => {
                        button.innerHTML = '<i class="fa-regular fa-clone"></i>';
                        button.classList.remove('copied');
                    }, 2000);
                });
                const wrapper = document.createElement('div');
                wrapper.className = 'code-block-wrapper';
                codeBlock.parentNode.insertBefore(wrapper, codeBlock);
                wrapper.appendChild(codeBlock);
                wrapper.appendChild(button);
            });
        }


        // Debounced resize reporting — coalesce rapid changes during streaming
        let _resizePending = false;
        let _lastReportedHeight = 0;
        function _flushResize() {
            _resizePending = false;
            const h = markdownRenderedElement.getBoundingClientRect().height;
            if (h > 0 && Math.abs(h - _lastReportedHeight) >= 1) {
                _lastReportedHeight = h;
                window.webkit.messageHandlers.sizeChangeHandler.postMessage(h);
            }
        }
        const resizeObserver = new ResizeObserver(() => {
            if (!_resizePending) {
                _resizePending = true;
                requestAnimationFrame(_flushResize);
            }
        });
        resizeObserver.observe(markdownRenderedElement);
    </script>
</body>

</html>
